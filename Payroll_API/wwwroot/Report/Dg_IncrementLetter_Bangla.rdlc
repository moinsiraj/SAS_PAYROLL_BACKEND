  <Code>Public Function ConvertDateToBangla(ByVal inputDate As DateTime) As String
    ' Bangla digits mapping
    Dim banglaDigits As String() = {"০", "১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯"}
    
    ' Month names in Bangla
    Dim banglaMonths As String() = {"জানুয়ারী", "ফেব্রুয়ারী", "মার্চ", "এপ্রিল", "মে", "জুন", "জুলাই", "আগস্ট", "সেপ্টেম্বর", "অক্টোবর", "নভেম্বর", "ডিসেম্বর"}
    
    ' Get day, month, and year
    Dim day As String = inputDate.Day.ToString()
    Dim month As String = banglaMonths(inputDate.Month - 1)
    Dim year As String = inputDate.Year.ToString()
    
    ' Convert digits in day and year to Bangla
    Dim banglaDay As String = ""
    Dim banglaYear As String = ""
    
    ' Convert day to Bangla
    For Each ch As Char In day
        banglaDay &amp;= banglaDigits(Integer.Parse(ch))
    Next
    
    ' Convert year to Bangla
    For Each ch As Char In year
        banglaYear &amp;= banglaDigits(Integer.Parse(ch))
    Next
    
    ' Return the formatted Bangla date (e.g., ১-জানুয়ারী-২০২৪)
    Return banglaDay &amp; "-" &amp; month &amp; "-" &amp; banglaYear
End Function</Code>
