                                <TextRun>
                                  <Value>=IIF(Fields!compid.Value = 38 Or Fields!compid.Value = 40 Or Fields!compid.Value = 61 Or Fields!compid.Value = 62 Or Fields!compid.Value = 49 
or Fields!compid.Value = 53 Or Fields!compid.Value = 37 Or Fields!compid.Value = 51 Or Fields!compid.Value = 56, System.Math.FLOOR(Int(Sum(System.Math.FLOOR(Fields!Total_OT.Value))) + Int(Sum((Fields!Total_OT.Value - System.Math.FLOOR(Fields!Total_OT.Value)) * 100)) / 60) &amp; "." &amp; Format((Sum(Fields!Total_OT.Value - System.Math.Floor(Fields!Total_OT.Value)) * 100) Mod 60, "00"), Sum(Fields!Total_OT.Value))</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
