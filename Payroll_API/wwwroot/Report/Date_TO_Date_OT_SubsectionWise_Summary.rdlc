                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!compid.Value = 38 Or Fields!compid.Value = 40 Or Fields!compid.Value = 61 Or Fields!compid.Value = 62 Or Fields!compid.Value = 49
or Fields!compid.Value = 53 Or Fields!compid.Value = 37 Or Fields!compid.Value = 51 Or Fields!compid.Value = 56, (Fields!Total_OT_min.Value * (Fields!Ot_Rate.Value / 60)) , (Sum(Fields!Total_OT.Value) * Fields!Ot_Rate.Value))</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <Format>0;(0)</Format>
                                  </Style>
