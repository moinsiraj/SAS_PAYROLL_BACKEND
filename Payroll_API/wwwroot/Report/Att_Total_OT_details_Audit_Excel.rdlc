                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Exot_2Hour1">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!compid.Value = 38 Or Fields!compid.Value = 40 Or Fields!compid.Value = 61 Or Fields!compid.Value = 49 or
    Fields!compid.Value = 53 Or Fields!compid.Value = 37 Or Fields!compid.Value = 51 Or Fields!compid.Value = 56,
    (FLOOR(Int((Sum(FLOOR(Fields!Exot_2Hour.Value))) + (Sum(FLOOR(Fields!Exot_After_Exot_2hour.Value)))) + 
	Int(Sum(((Fields!Exot_2Hour.Value + Fields!Exot_After_Exot_2hour.Value) - 
	(FLOOR(Fields!Exot_2Hour.Value) + FLOOR(Fields!Exot_After_Exot_2hour.Value))) * 100)) / 60)) &amp; "." &amp;
    Format((Sum((Fields!Exot_2Hour.Value + Fields!Exot_After_Exot_2hour.Value) - 
	(Floor(Fields!Exot_2Hour.Value) + Floor(Fields!Exot_After_Exot_2hour.Value))) * 100) Mod 60, "00"),
    SUM(Fields!Exot_2Hour.Value + Fields!Exot_After_Exot_2hour.Value)
)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Exot_2Hour1</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
