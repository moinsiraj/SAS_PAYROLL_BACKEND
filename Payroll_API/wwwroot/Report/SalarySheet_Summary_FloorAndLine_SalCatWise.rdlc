                                <TextRun>
                                  <Value>=IIF(Fields!compid.Value = 38 Or Fields!compid.Value = 40 Or Fields!compid.Value = 61 Or Fields!compid.Value = 62 Or Fields!compid.Value = 49
or Fields!compid.Value = 53 Or Fields!compid.Value = 37 Or Fields!compid.Value = 51 Or Fields!compid.Value = 56, System.Math.FLOOR(Int(Sum(System.Math.FLOOR(Fields!ss_overtimehrs.Value))) + Int(Sum((Fields!ss_overtimehrs.Value - System.Math.FLOOR(Fields!ss_overtimehrs.Value)) * 100)) / 60) &amp; "." &amp; Format((Sum(Fields!ss_overtimehrs.Value - System.Math.Floor(Fields!ss_overtimehrs.Value)) * 100) Mod 60, "00"), Sum(Fields!ss_overtimehrs.Value))</Value>
                                  <Style>
                                    <FontSize>6pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.00;(0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
