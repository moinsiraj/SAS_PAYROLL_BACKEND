                                  </TablixRow>
                                  <TablixRow>
                                    <Height>2.73611in</Height>
                                    <TablixCells>
                                      <TablixCell>
                                        <CellContents>
                                          <Textbox Name="Textbox56">
                                            <CanGrow>true</CanGrow>
                                            <KeepTogether>true</KeepTogether>
                                            <Paragraphs>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>1. I hereby apply for a DBBL Nexus Prepaid Card after fully</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    understanding the features terms and conditions of the</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    product</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value />
                                                    <Style>
                                                      <FontSize>3pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>2. I confirm that the information provided in this application are</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    true and correct</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value />
                                                    <Style>
                                                      <FontSize>3pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>3. I accept that DBBL has the right to accept or reject the</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    application without assigning any reason</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value />
                                                    <Style>
                                                      <FontSize>3pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>4. I hereby authorize DBBL to verify any/all information from any</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    sources it may consider appropriate</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value />
                                                    <Style>
                                                      <FontSize>3pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>5. I agree to pay the fees/charges for issuing and maintaining this</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    card as determined by the bank at any point of time.</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value />
                                                    <Style>
                                                      <FontSize>3pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>6. I confirm that fund used to purchase this card is legally</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    sourced and the card will not be used for any illegal means</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value />
                                                    <Style>
                                                      <FontSize>3pt</FontSize>
                                                    </Style>
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>7. I shall maintain confidentiality of all card related information</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                              <Paragraph>
                                                <TextRuns>
                                                  <TextRun>
                                                    <Value>    and ensure safekeeping of the card.</Value>
                                                    <Style />
                                                  </TextRun>
                                                </TextRuns>
                                                <Style />
                                              </Paragraph>
                                            </Paragraphs>
                                            <rd:DefaultName>Textbox56</rd:DefaultName>
